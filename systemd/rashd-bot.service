[Unit]
Description=Rashd-Ai Intelligence Telegram Bot
After=network-online.target
Wants=network-online.target
Restart=always
RestartSec=10

[Service]
Type=simple
# عدّل المسار إلى مجلد البوت لديك
WorkingDirectory=/home/ubuntu/Bot.Ai
# عدّل المسار إلى مترجم بايثون لديك
ExecStart=/usr/bin/python3 /home/ubuntu/Bot.Ai/main_bot.py
# المتغيرات البيئية — ضع مفاتيحك هنا أو في ملف EnvironmentFile
EnvironmentFile=/home/ubuntu/Bot.Ai/.env
StandardOutput=append:/home/ubuntu/Bot.Ai/bot_service.log
StandardError=append:/home/ubuntu/Bot.Ai/bot_service.log

# إعادة تشغيل تلقائية عند أي تعطل
Restart=always
RestartSec=15
StartLimitIntervalSec=60
StartLimitBurst=10

[Install]
WantedBy=multi-user.target
